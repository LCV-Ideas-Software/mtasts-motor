{
  "name": "mtasts-motor",
  "version": "2.0.13",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that serves dynamic MTA-STS policies for mta-sts.* subdomains, sourcing active policy text from a D1 binding.",
  "license": "AGPL-3.0-or-later",
  "author": "LCV Ideas & Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LCV-Ideas-Software/mtasts-motor.git"
  },
  "homepage": "https://github.com/LCV-Ideas-Software/mtasts-motor#readme",
  "bugs": {
    "url": "https://github.com/LCV-Ideas-Software/mtasts-motor/issues"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "format": "biome format --write src && prettier --write \"**/*.{html,json,jsonc,md,mjs,yaml,yml}\" \"eslint.config.js\"",
    "format:check": "prettier --check \"**/*.{html,json,jsonc,md,mjs,yaml,yml}\" \"eslint.config.js\"",
    "lint": "eslint . --max-warnings=0",
    "biome": "biome check .",
    "biome:write": "biome check --write .",
    "markdownlint": "node scripts/markdownlint-workspace.mjs",
    "test:official-actions": "node --test scripts/official-actions-contract.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && npm run test:official-actions",
    "format:public": "prettier --write \"**/index.html\"",
    "format:public:check": "prettier --check \"**/index.html\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@cloudflare/workers-types": "^5.20260818.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.0"
    },
    "ws": "8.21.0",
    "esbuild": "0.28.1",
    "sharp": "0.35.3"
  }
}
